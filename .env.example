# Path to OpenCode's SQLite database (auto-detected when empty)
OPENCODE_DB=
# Minutes east of UTC for day/hour bucketing (defaults to the machine offset)
TZ_OFFSET_MINUTES=
# Short label shown in timestamps (defaults to LOCAL)
TZ_LABEL=
# Set to 1 to show the Next.js dev-tools bubble (hidden by default)
NEXT_DEV_INDICATORS=
